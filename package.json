{
  "name": "httpv",
  "version": "0.1.0",
  "description": "Discover and verify certificates of API behavior over HTTP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeframLou/httpv.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "example": "bun examples/upgrades.ts",
    "prove": "bun scripts/prove.ts",
    "check:certificates": "bun scripts/check-certificates.ts",
    "format": "prettier --write src tests/*.ts scripts examples/*.ts package.json tsconfig.json *.md docs",
    "format:check": "prettier --check src tests/*.ts scripts examples/*.ts package.json tsconfig.json *.md docs"
  },
  "peerDependencies": {
    "zklean": "0.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "zklean": "git+https://git@github.com/ZeframLou/zklean.git#eec9b59b3825efa2a6906f9fd22e6a27601dcc82"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "src",
    "README.md",
    "SPEC.md",
    "docs"
  ]
}
