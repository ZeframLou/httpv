{
  "name": "httpv",
  "version": "0.1.0",
  "description": "Discover and verify formal API contracts over HTTP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeframLou/httpv.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "example": "bun examples/upgrades.ts",
    "fixtures": "bun scripts/refresh-fixtures.ts",
    "format": "prettier --write src tests/*.ts scripts/*.ts examples/*.ts package.json tsconfig.json",
    "format:check": "prettier --check src tests/*.ts scripts/*.ts examples/*.ts package.json tsconfig.json"
  },
  "peerDependencies": {
    "zklean": "0.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "zklean": "git+https://git@github.com/ZeframLou/zklean.git#7ff4d87a522828d813033b3580922b225e82bb9a"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "src",
    "README.md",
    "SPEC.md",
    "docs/USAGE.md",
    "docs/ENCODING.md"
  ]
}
